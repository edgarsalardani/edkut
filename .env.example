# =============================================================================
# EdKut — variáveis de ambiente (modelo). Copie para .env.local e preencha.
#   cp .env.example .env.local
# .env.local já é ignorado pelo Git (.gitignore: ".env*.local"). NUNCA faça commit dele.
#
# Onde achar os valores: Supabase Dashboard > Project Settings > API
# (a tela de chaves pode se chamar "API Keys"; confira os nomes atuais no painel).
# =============================================================================

# URL do projeto. Pública por natureza (vai para o navegador).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave PÚBLICA do projeto (anon / publishable). Pode ir ao navegador: quem protege
# os dados são as policies de RLS, não o segredo desta chave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-ou-publishable

# (Opcional — o código atual usa o endereço da própria janela do navegador para o link de
# confirmação de e-mail. Mantida para quando houver domínio de produção.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# NÃO configure agora. Chave de serviço (service_role / secret): IGNORA o RLS.
# Só para scripts administrativos rodando no servidor ou na sua máquina (ex.: seed).
# Jamais use o prefixo NEXT_PUBLIC_ nela, jamais importe em código de cliente.
# -----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=
